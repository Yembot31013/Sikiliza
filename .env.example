# Preferred for Swahili / African code-switching STT.
# https://docs.voice.intron.io/docs/stt/streaming
INTRON_API_KEY=
# Intron ASR language (required by their API). sw = Swahili-English code-switch.
INTRON_SOURCE_LANG=sw

# Preferred for auto language detection + broad multilingual.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Strong Whisper fallback. https://console.groq.com/keys
GROQ_API_KEY=

# Extra fallback. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Chat model used by Groq after Whisper / Intron translate.
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Gemini STT + translation models
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_CHAT_MODEL=gemini-2.5-flash

# accurate = transcribe then translate
# fast = quicker path when supported
SIKILIZA_MODE=accurate

# auto | intron | gemini | groq | openai | local
# auto prefers Gemini, then Groq, OpenAI, Intron, local Whisper
# Set SIKILIZA_PROVIDER=intron to force Intron STT
SIKILIZA_PROVIDER=gemini

# Default caption target language (UI can change this live)
SIKILIZA_TARGET_LANG=en

SIKILIZA_HOST=127.0.0.1
SIKILIZA_PORT=8765
SIKILIZA_ALLOWED_ORIGINS=["http://127.0.0.1:5273","http://localhost:5273"]

# Local Whisper only used when no cloud key is set.
WHISPER_MODEL=small
